#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/gpio/gpio.h>
#include "../../../behaviors/cirque_pointing.dtsi"

/ {
    chosen {
        zmk,kscan = &mock_kscan;
        zmk,matrix_transform = &default_transform;
    };

    mock_kscan: mock_kscan_0 {
        compatible = "zmk,kscan-mock";
        columns = <0>;
        rows = <0>;
        events = <0>;
    };

    // Universal dongle transform: supports Corne, Sweep, and Totem simultaneously.
    //
    // Global column layout (12 columns × 4 rows):
    //   col 0      : Corne left outer (finger rows only)
    //   cols 1-5   : Left inner finger keys (Sweep, Totem, Corne)
    //   cols 6-10  : Right inner finger keys (Sweep, Totem, Corne)
    //   col 11     : Corne right outer (finger rows only)
    //
    // Thumb row (row 3):
    //   RC(3,1)    : Totem ESC outer key
    //   RC(3,3-5)  : Left thumb cluster (all keyboards)
    //   RC(3,6-8)  : Right thumb cluster (all keyboards)
    //   RC(3,10)   : Totem BSLH outer key
    //
    // Keymap binding order per layer (44 keys):
    //   &none KM_*_R0 &none  (12 bindings × 3 finger rows)
    //   &kp ESC KM_THUMBS &kp BSLH  (8 bindings)
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <4>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)    RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)    RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)    RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
            RC(3,1) RC(3,3) RC(3,4) RC(3,5)                    RC(3,6) RC(3,7) RC(3,8) RC(3,10)
        >;
    };

    // No physical encoders on the dongle: these disabled nodes are just
    // slots so the keymap sensor indexes match the peripheral halves.
    // sweep_dongle_left sends sensor index 0 (left encoder) and sweep_right
    // sends index 1 (right encoder) over the split transport.
    dongle_enc_left: dongle_enc_left {
        compatible = "alps,ec11";
        a-gpios = <&gpio0 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&gpio1 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <15>;
        status = "disabled";
    };
    dongle_enc_right: dongle_enc_right {
        compatible = "alps,ec11";
        a-gpios = <&gpio0 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&gpio1 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <15>;
        status = "disabled";
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&dongle_enc_left &dongle_enc_right>;
    };

    // Split input transport — receives pointing data from sweep_right trackpad
    split_inputs {
        #address-cells = <1>;
        #size-cells = <0>;

        glidepoint_split: glidepoint_split@0 {
            compatible = "zmk,input-split";
            reg = <0>;
        };
    };
    glidepoint_listener: glidepoint_listener {
        compatible = "zmk,input-listener";
        status = "okay";
        device = <&glidepoint_split>;
        // Pointer-speed processor: scales trackpad REL_X/Y on the central.
        input-processors = <&pointer_processor 0 0>;
    };
};
